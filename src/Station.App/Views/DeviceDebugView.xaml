<UserControl x:Class="Station.App.Views.DeviceDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Station.App.ViewModels">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8"
                 Text="Devices" />
      <ListBox ItemsSource="{Binding Devices}"
               SelectedItem="{Binding SelectedDevice}"
               DisplayMemberPath="Title" />
    </DockPanel>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="120" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock FontWeight="SemiBold" Text="{Binding HeaderText}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Opacity="0.75" Text="{Binding PanelHint}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Connect"
                  Width="90"
                  Command="{Binding ConnectCommand}" />
          <Button Content="Disconnect"
                  Width="90"
                  Margin="8,0,0,0"
                  Command="{Binding DisconnectCommand}" />
          <Button Content="Reconnect"
                  Width="90"
                  Margin="8,0,0,0"
                  Command="{Binding ReconnectCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Health"
                  Width="90"
                  Command="{Binding RefreshHealthCommand}" />
          <TextBlock Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding HealthText}" />
        </StackPanel>
      </StackPanel>

      <!-- Power meter -->
      <Border Grid.Row="1"
              Padding="8"
              Margin="0,0,0,8"
              BorderBrush="#CCC"
              BorderThickness="1"
              Visibility="{Binding IsPowerMeter, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="OpticalPowerMeter" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="Channel" Width="70" />
            <TextBox Width="60" Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="8,0,0,0" Width="90" Content="ReadPower" Command="{Binding ReadPowerCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="λ (nm)" Width="70" />
            <TextBox Width="80" Text="{Binding WavelengthNm, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="8,0,0,0" Width="110" Content="SetWavelength" Command="{Binding SetMeterWavelengthCommand}" />
          </StackPanel>
          <TextBlock Margin="0,8,0,0" Text="{Binding UplinkValue, StringFormat=Uplink: {0}}" />
        </StackPanel>
      </Border>

      <!-- Laser -->
      <Border Grid.Row="1"
              Padding="8"
              Margin="0,0,0,8"
              BorderBrush="#CCC"
              BorderThickness="1"
              Visibility="{Binding IsLaser, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="LaserSource" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="λ (nm)" Width="70" />
            <TextBox Width="80" Text="{Binding WavelengthNm, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="8,0,0,0" Width="110" Content="SetWavelength" Command="{Binding SetLaserWavelengthCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="Output On"
                      IsChecked="{Binding LaserOutputEnabled}"
                      VerticalAlignment="Center" />
            <Button Margin="12,0,0,0" Width="100" Content="Apply Output" Command="{Binding SetLaserOutputCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Switch -->
      <Border Grid.Row="1"
              Padding="8"
              Margin="0,0,0,8"
              BorderBrush="#CCC"
              BorderThickness="1"
              Visibility="{Binding IsOpticalSwitch, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="OpticalSwitch" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="In" Width="30" />
            <TextBox Width="50" Text="{Binding InputPort, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Out" Width="30" />
            <TextBox Width="50" Text="{Binding OutputPort, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="12,0,0,0" Width="90" Content="SwitchTo" Command="{Binding SwitchToCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="2"
                 Margin="0,0,0,4"
                 FontWeight="SemiBold"
                 Text="Log" />
      <TextBox Grid.Row="3"
               IsReadOnly="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas"
               Text="{Binding LogText}" />

      <DockPanel Grid.Row="4" Margin="0,8,0,4">
        <Button DockPanel.Dock="Right"
                Width="90"
                Content="Refresh Audit"
                Command="{Binding RefreshAuditCommand}" />
        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Audit" />
      </DockPanel>
      <TextBox Grid.Row="5"
               IsReadOnly="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas"
               FontSize="11"
               Text="{Binding AuditText}" />
    </Grid>
  </Grid>
</UserControl>
