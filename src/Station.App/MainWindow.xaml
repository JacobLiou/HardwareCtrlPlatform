<Window x:Class="Station.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Station.App.Views"
        Title="HardwareCtrlPlatform"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterScreen">
  <TabControl Margin="8">
    <TabItem Header="Station">
      <views:StationHomeView DataContext="{Binding Station}" />
    </TabItem>
    <TabItem Header="Devices">
      <views:DeviceDebugView DataContext="{Binding Devices}" />
    </TabItem>
  </TabControl>
</Window>
