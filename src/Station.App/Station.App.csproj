<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>Station.App</RootNamespace>
    <AssemblyName>Station.App</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Station.Workflow\Station.Workflow.csproj" />
    <ProjectReference Include="..\Device.Hosting\Device.Hosting.csproj" />
    <ProjectReference Include="..\Device.Client\Device.Client.csproj" />
    <ProjectReference Include="..\Device.Contracts\Device.Contracts.csproj" />
    <ProjectReference Include="..\Device.Server\Device.Server.csproj" />
    <ProjectReference Include="..\Device.Tags\Device.Tags.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
